{
  "name": "level-cruise-template",
  "_templateNotes": [
    "Add a complete flightRequest when the runner should reposition or load an aircraft.",
    "Replace aircraft/custom/pilot_mass_kg with an aircraft-owned adjustable station dataref.",
    "Replace mode commands and status values with the aircraft's proven native mappings.",
    "For climb or acceleration cards, seed the adjustable mass dataref in setupDatarefs before convergence; massCorrection fine-tunes it afterward."
  ],
  "immediatePauseTimeoutSeconds": 20,
  "pluginInitSeconds": 8,
  "discoveryTimeoutSeconds": 30,
  "commandDurationSeconds": 0.2,
  "stabilizeSeconds": 90,
  "sampleCount": 15,
  "sampleIntervalMs": 750,
  "resetDatarefs": [
    {
      "name": "sim/cockpit2/autopilot/sync_hold_pitch_deg",
      "value": 1.5,
      "readbackTolerance": 0.05
    },
    {
      "name": "sim/cockpit2/autopilot/altitude_dial_ft",
      "value": 6000.0,
      "readbackTolerance": 1.0
    }
  ],
  "setupDatarefs": [
    {
      "name": "sim/cockpit2/engine/actuators/throttle_ratio_all",
      "value": 0.5,
      "readbackTolerance": 0.01
    }
  ],
  "pausedCommands": [],
  "afterSetupCommands": [
    {
      "name": "sim/autopilot/heading",
      "durationSeconds": 0.2
    },
    {
      "name": "sim/autopilot/altitude_hold",
      "durationSeconds": 0.2
    },
    {
      "name": "sim/autopilot/servos_on",
      "durationSeconds": 0.2
    }
  ],
  "afterCommandDatarefs": [],
  "postCommandState": {
    "timeoutSeconds": 15,
    "intervalMs": 500,
    "consecutiveChecks": 2,
    "conditions": [
      {
        "name": "sim/cockpit2/autopilot/servos_on",
        "target": 1,
        "tolerance": 0
      },
      {
        "name": "sim/cockpit2/autopilot/altitude_mode",
        "target": 6,
        "tolerance": 0
      }
    ]
  },
  "convergence": {
    "timeoutSeconds": 180,
    "intervalMs": 2000,
    "consecutiveChecks": 3,
    "conditions": [
      {
        "name": "sim/flightmodel/position/elevation",
        "target": 1828.8,
        "tolerance": 2.44
      },
      {
        "name": "sim/flightmodel/position/vh_ind_fpm",
        "target": 0,
        "tolerance": 50
      }
    ]
  },
  "massCorrection": {
    "totalMassDataref": "sim/flightmodel/weight/m_total",
    "adjustDataref": "aircraft/custom/pilot_mass_kg",
    "target": 1179.34,
    "tolerance": 0.25,
    "maxIterations": 3,
    "settleMs": 500
  },
  "sampleDatarefs": [
    "sim/flightmodel/position/indicated_airspeed",
    "sim/flightmodel/position/true_airspeed",
    "sim/flightmodel/position/vh_ind_fpm",
    "sim/flightmodel/position/elevation",
    "sim/flightmodel/position/phi",
    "sim/flightmodel/weight/m_total",
    "sim/cockpit2/autopilot/servos_on",
    "sim/cockpit2/autopilot/altitude_mode"
  ],
  "reject": {
    "servoDataref": "sim/cockpit2/autopilot/servos_on",
    "bankDataref": "sim/flightmodel/position/phi",
    "maxAbsBank": 3.0,
    "requiredValues": [
      {
        "name": "sim/cockpit2/autopilot/altitude_mode",
        "value": 6,
        "tolerance": 0
      }
    ],
    "meanTargets": [
      {
        "name": "sim/flightmodel/weight/m_total",
        "target": 1179.34,
        "tolerance": 1.0
      }
    ],
    "maxRanges": [
      {
        "name": "sim/flightmodel/position/indicated_airspeed",
        "max": 1.0
      },
      {
        "name": "sim/flightmodel/position/elevation",
        "max": 6.1
      }
    ]
  }
}